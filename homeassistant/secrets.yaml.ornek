# /config/secrets.yaml içine EKLE (dosyadaki diğer satırları silme).
# Değerleri openjarvis VM'inde şu komut verir:  ./openjarvis/kur.sh anahtar

openjarvis_url: "http://192.168.1.51:8000/v1/chat/completions"
openjarvis_auth: "Bearer BURAYA_OPENJARVIS_API_ANAHTARI"

# Windows bilgisayarın Ethernet MAC adresi (windows/wol-hazirla.ps1 gösterir)
pc_mac: "AA:BB:CC:DD:EE:FF"

# ESPHome ses uydusu için (ESPHome Device Builder → Secrets)
wifi_ssid: "EV_WIFI_ADI"
wifi_password: "EV_WIFI_SIFRESI"
