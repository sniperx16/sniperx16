# =====================================================================
#  Ev Jarvis'i – ortak ayarlar
#  Bu dosyayı "jarvis.env" adıyla kopyala ve kendi değerlerini yaz:
#      cp jarvis.env.ornek jarvis.env && nano jarvis.env
#  "jarvis.env" gizli bilgi içerir; .gitignore sayesinde GitHub'a gitmez.
# =====================================================================

# --- Ev ağı ----------------------------------------------------------
# Modeminin adresi (genelde 192.168.1.1 veya 192.168.0.1)
GATEWAY="192.168.1.1"
# Ağ maskesi (neredeyse her evde 24)
CIDR="24"
DNS="1.1.1.1"

# Sabit IP adresleri. Modemin DHCP aralığının DIŞINDA olmalı
# (örn. modem .100–.200 arası dağıtıyorsa .50–.60 güvenlidir).
PROXMOX_IP="192.168.1.50"
HA_IP="192.168.1.52"        # Home Assistant (modemden DHCP rezervasyonu ile sabitlenecek)
JARVIS_IP="192.168.1.51"    # OpenJarvis Ubuntu sanal makinesi (betik sabit verir)

# --- Sanal makineler ---------------------------------------------------
HA_VMID="100"
HA_CORES="3"   # ses tanıma (Whisper) için 3 çekirdek; Proxmox çekirdekleri paylaştırır
HA_RAM_MB="4096"
HA_DISK="32G"

JARVIS_VMID="101"
JARVIS_CORES="4"
JARVIS_RAM_MB="16384"   # 24 GB toplam RAM: HA 4 + Jarvis 16 + Proxmox ~3-4
JARVIS_DISK="200G"
JARVIS_USER="jarvis"
# Ubuntu VM'ye ilk giriş şifresi (kurulumdan sonra değiştir)
JARVIS_PASSWORD="BunuDegistir123!"

# --- Windows bilgisayar ------------------------------------------------
# Windows'ta: windows\wol-hazirla.ps1 çıktısındaki MAC adresi
PC_MAC="AA:BB:CC:DD:EE:FF"
